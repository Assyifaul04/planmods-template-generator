// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  ADMIN
  USER
}

enum Plan {
  FREE
  PRO
  TEAM
}

enum Platform {
  JAVA
  BEDROCK
}

enum Loader {
  // java/
  FABRIC
  FORGE
  NEOFORGE
  QUILT
  PAPER
  SPIGOT
  PURPUR
  FOLIA
  VELOCITY
  WATERFALL
  BUNGEECORD
  // bedrock/
  ADDON
  SCRIPT
}

enum ProjectVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum ProjectStatus {
  DRAFT
  GENERATING
  READY
  FAILED
  ARCHIVED
}

enum CollaboratorRole {
  OWNER
  EDITOR
  VIEWER
}

enum BuildStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// =============================================================================
// AUTH — kompatibel dengan NextAuth.js (Auth.js)
// =============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  website       String?

  role     Role    @default(USER)
  plan     Plan    @default(FREE)
  isActive Boolean @default(true)
  isBanned Boolean @default(false)

  githubId       String? @unique
  githubUsername String?
  googleId       String? @unique

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  projects        Project[]
  repositories    GithubRepository[]
  activities      ActivityLog[]
  downloads       DownloadHistory[]
  apiKeys         ApiKey[]
  notifications   Notification[]
  collaborations  ProjectCollaborator[]
  stars           ProjectStar[]
  triggeredBuilds BuildHistory[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// MINECRAFT VERSION & LOADER (Terhubung ke Project & Template)
// =============================================================================

model MinecraftVersion {
  id          String    @id @default(cuid())
  version     String    @unique // Cth: "1.20.4"
  platform    Platform
  isLatest    Boolean   @default(false)
  isSnapshot  Boolean   @default(false)
  releaseDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi
  loaderVersions LoaderMinecraftVersion[]
  projects       Project[] // Relasi back-reference ke Project
  templates      Template[] // Relasi back-reference ke Template

  @@index([platform])
  @@map("minecraft_versions")
}

model LoaderMinecraftVersion {
  id String @id @default(cuid())

  loader Loader

  minecraftVersionId String
  minecraftVersion   MinecraftVersion @relation(fields: [minecraftVersionId], references: [id], onDelete: Cascade)

  loaderVersion String

  apiVersion      String?
  loomVersion     String?
  mappingsVersion String?

  gradleVersion String?
  javaVersion   String?
  jdkVersion    String?

  repository String?

  recommended Boolean @default(false)
  supported   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates Template[]

  @@unique([loader, minecraftVersionId])
  @@index([minecraftVersionId])
  @@index([loader])
  @@map("loader_minecraft_versions")
}

// =============================================================================
// TEMPLATE REPOSITORY
// =============================================================================

model TemplateRepo {
  id        String   @id @default(cuid())
  platform  Platform
  loader    Loader
  repoUrl   String // URL git repository
  branch    String   @default("main")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates Template[]

  @@unique([platform, loader])
  @@map("template_repos")
}

// =============================================================================
// TEMPLATE & TAG
// =============================================================================

model Template {
  id String @id @default(cuid())

  name         String
  slug         String  @unique
  description  String?
  thumbnailUrl String?

  platform         Platform
  loader           Loader
  minecraftVersion String // Foreign key (String version)

  path           String
  templateRepoId String?

  repoUrl   String?
  gradleUrl String?

  enabled    Boolean @default(true)
  isFeatured Boolean @default(false)
  usageCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templateRepo  TemplateRepo?    @relation(fields: [templateRepoId], references: [id], onDelete: SetNull)
  mcVersionData MinecraftVersion @relation(fields: [minecraftVersion], references: [version], onDelete: Restrict) // <--- RELASI BARU

  projects                 Project[]
  tags                     TemplateTag[]
  LoaderMinecraftVersion   LoaderMinecraftVersion? @relation(fields: [loaderMinecraftVersionId], references: [id])
  loaderMinecraftVersionId String?

  @@unique([platform, loader, minecraftVersion])
  @@index([platform, loader])
  @@index([minecraftVersion])
  @@map("templates")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  templates TemplateTag[]

  @@map("tags")
}

model TemplateTag {
  templateId String
  tagId      String
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([templateId, tagId])
  @@index([tagId])
  @@map("template_tags")
}

// =============================================================================
// PROJECT & CONFIGURATION
// =============================================================================

model Project {
  id String @id @default(cuid())

  userId     String
  templateId String?

  name        String
  slug        String
  description String?

  platform         Platform
  loader           Loader
  minecraftVersion String // Foreign key (String version)

  packageName String
  modId       String
  author      String

  version String @default("1.0.0")
  license String @default("MIT")

  status     ProjectStatus     @default(DRAFT)
  visibility ProjectVisibility @default(PRIVATE)

  dependencies Json?
  metadata     Json?

  starsCount     Int @default(0)
  downloadsCount Int @default(0)

  lastBuildAt DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  mcVersionData MinecraftVersion @relation(fields: [minecraftVersion], references: [version], onDelete: Restrict) // <--- RELASI BARU

  githubRepository GithubRepository?
  config           ProjectConfig?
  downloads        DownloadHistory[]
  builds           BuildHistory[]
  collaborators    ProjectCollaborator[]
  stars            ProjectStar[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([templateId])
  @@index([status])
  @@index([visibility])
  @@index([minecraftVersion])
  @@map("projects")
}

model ProjectConfig {
  id        String @id @default(cuid())
  projectId String @unique

  loaderVersion    String?
  fabricApiVersion String?
  loomVersion      String?
  javaVersion      String?
  gradleVersion    String?
  yarnVersion      String?
  mappingVersion   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_configs")
}

model ProjectCollaborator {
  id        String           @id @default(cuid())
  projectId String
  userId    String
  role      CollaboratorRole @default(VIEWER)
  invitedBy String?
  createdAt DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_collaborators")
}

model ProjectStar {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_stars")
}

// =============================================================================
// GITHUB INTEGRATION
// =============================================================================

model GithubRepository {
  id String @id @default(cuid())

  userId    String
  projectId String @unique

  repositoryName String
  repositoryUrl  String
  cloneUrl       String
  defaultBranch  String  @default("main")
  private        Boolean @default(true)

  webhookId     String?
  webhookSecret String?
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("github_repositories")
}

model BuildHistory {
  id String @id @default(cuid())

  projectId     String
  triggeredById String?

  status       BuildStatus @default(PENDING)
  logs         String?     @db.Text
  errorMessage String?

  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?

  createdAt DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggeredBy User?   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@map("build_history")
}

// =============================================================================
// RIWAYAT & AKTIVITAS
// =============================================================================

model DownloadHistory {
  id String @id @default(cuid())

  userId    String
  projectId String

  ipAddress String?
  userAgent String?

  downloadedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@map("download_history")
}

model ActivityLog {
  id String @id @default(cuid())

  userId String

  action   String
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// =============================================================================
// API KEY & NOTIFIKASI
// =============================================================================

model ApiKey {
  id String @id @default(cuid())

  userId    String
  name      String
  keyHash   String @unique
  keyPrefix String

  scopes String[] @default([])

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Notification {
  id String @id @default(cuid())

  userId String

  type    NotificationType @default(INFO)
  title   String
  message String
  link    String?

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}
